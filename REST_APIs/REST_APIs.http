@rootURL = http://localhost:5109

GET {{rootURL}}/weatherforecast/
Accept: application/json

###
GET {{rootURL}}/api/books
Accept: application/json

###
GET {{rootURL}}/api/books/2
Accept: application/json

###
POST {{rootURL}}/api/books
Content-Type: application/json
{
  "title": "C# Advance",
  "author": "Crafter",
  "yearPublished": 2024
}

###
PUT {{rootURL}}/api/books/5
Content-Type: application/json
{
    "id": 5,
    "title": "Moby-Dick",
    "author": "Mazhar",
    "yearPublished": 1851
}

###
DELETE {{rootURL}}/api/books/4


###
# PATCH request - Update only specific fields of book with ID 2
PATCH {{rootURL}}/api/books/2
Content-Type: application/json
{
  "title": "Updated Book Title",
  "author": "Mazhar Rehan"
}

###
# PATCH request - Update only the year published
PATCH {{rootURL}}/api/books/1
Content-Type: application/json
{
  "yearPublished": 2025
}

###
# PATCH request - Update only the author
PATCH {{rootURL}}/api/books/3
Content-Type: application/json
{
  "author": "New Author Name"
}